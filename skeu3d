/* ============================================================
   KELVERIS TECHNOLOGIES — 3D Depth Layer
   Adds real CSS 3D transforms, perspective, and tilt on top
   of the existing skeuomorphic (skeu.css) design system.
   Include this AFTER skeu.css.
   ============================================================ */

:root {
  --tilt-deg: 8deg;
  --depth-shadow: 0 35px 60px -15px rgba(0,0,0,0.6);
}

/* ============================================================
   GLOBAL 3D STAGE
   ============================================================ */
.skeu-hero {
  perspective: 1400px;
  transform-style: preserve-3d;
}

/* ============================================================
   HERO LOGO — full 3D rotating panel
   ============================================================ */
.hero-logo-panel {
  transform-style: preserve-3d;
  transform: rotateY(-10deg) rotateX(6deg);
  animation: panel-float-3d 6s ease-in-out infinite;
  box-shadow:
    var(--shadow-deep),
    inset 0 1px 0 rgba(255,255,255,0.5),
    inset 0 -1px 0 rgba(0,0,0,0.2),
    25px 35px 50px -10px rgba(0,0,0,0.55);
}

.hero-logo-panel img {
  transform: translateZ(20px);
}

@keyframes panel-float-3d {
  0%, 100% { transform: rotateY(-10deg) rotateX(6deg) translateY(0) translateZ(0); }
  50%      { transform: rotateY(-6deg) rotateX(3deg) translateY(-14px) translateZ(10px); }
}

/* depth pedestal under the logo panel */
.hero-logo-panel::after {
  content: '';
  position: absolute;
  left: 8%; right: 8%; bottom: -22px;
  height: 18px;
  background: radial-gradient(ellipse at center, rgba(0,0,0,0.45) 0%, transparent 75%);
  border-radius: 50%;
  filter: blur(4px);
  z-index: -1;
  transform: translateZ(-30px);
}

/* ============================================================
   CARDS — full perspective tilt on hover, true 3D push
   ============================================================ */
.skeu-card {
  transform-style: preserve-3d;
  transition: transform 0.35s cubic-bezier(.2,.8,.3,1), box-shadow 0.35s;
  will-change: transform;
}

.skeu-card:hover {
  transform: translateY(-10px) translateZ(20px) rotateX(4deg) rotateY(-3deg);
  box-shadow:
    var(--depth-shadow),
    -2px -2px 8px rgba(255,255,255,0.3) inset;
}

.card-icon-panel {
  transform: translateZ(6px);
}

.skeu-card .card-body {
  transform: translateZ(2px);
}

/* ============================================================
   NAVBAR — subtle 3D button presses
   ============================================================ */
.nav-links li a {
  transform-style: preserve-3d;
  transition: transform 0.15s, all 0.15s;
}

.nav-links li a:hover,
.nav-links li a.active {
  transform: translateZ(6px) translateY(-1px);
}

/* ============================================================
   BUTTONS — extruded 3D press effect
   ============================================================ */
.btn-skeu-primary {
  transform-style: preserve-3d;
  box-shadow:
    0 1px 0 rgba(255,255,255,0.7) inset,
    0 -1px 0 rgba(0,0,0,0.15) inset,
    0 6px 0 var(--amber-dark),
    0 10px 18px rgba(0,0,0,0.4);
  transition: transform 0.15s, box-shadow 0.15s;
}

.btn-skeu-primary:hover {
  transform: translateY(-3px) translateZ(8px);
  box-shadow:
    0 1px 0 rgba(255,255,255,0.7) inset,
    0 -1px 0 rgba(0,0,0,0.15) inset,
    0 9px 0 var(--amber-dark),
    0 16px 28px rgba(212,134,10,0.4);
}

.btn-skeu-primary:active {
  transform: translateY(4px) translateZ(0);
  box-shadow:
    0 1px 0 rgba(0,0,0,0.2) inset,
    0 1px 0 var(--amber-dark),
    0 2px 6px rgba(0,0,0,0.3);
}

.btn-skeu-outline {
  transform-style: preserve-3d;
  box-shadow:
    0 0 0 2px var(--metal-mid) inset,
    0 6px 0 rgba(0,0,0,0.25),
    0 10px 16px rgba(0,0,0,0.3);
  transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s, color 0.15s, background 0.15s;
}

.btn-skeu-outline:hover {
  transform: translateY(-3px) translateZ(6px);
  box-shadow:
    0 0 0 2px var(--amber-glow) inset,
    0 8px 0 rgba(0,0,0,0.2),
    0 14px 22px rgba(0,0,0,0.35);
}

.btn-skeu-outline:active {
  transform: translateY(4px) translateZ(0);
}

/* ============================================================
   STATS STRIP — 3D embossed gauge numbers
   ============================================================ */
.stat-item {
  transform-style: preserve-3d;
  transition: transform 0.3s;
}

.stat-item:hover {
  transform: translateZ(14px) scale(1.04);
}

.stat-number {
  text-shadow:
    0 0 20px rgba(245,166,35,0.5),
    0 2px 0 rgba(0,0,0,0.5),
    0 4px 8px rgba(0,0,0,0.4);
}

/* ============================================================
   TEAM CARDS — 3D flip-tilt
   ============================================================ */
.team-card {
  transform-style: preserve-3d;
  transition: transform 0.3s cubic-bezier(.2,.8,.3,1), box-shadow 0.3s;
}

.team-card:hover {
  transform: translateY(-6px) translateZ(14px) rotateX(5deg);
  box-shadow:
    0 20px 30px rgba(0,0,0,0.4),
    -1px -1px 4px rgba(255,255,255,0.3) inset;
}

/* ============================================================
   CONTACT INFO BLOCKS — raised hardware with depth
   ============================================================ */
.contact-info-block {
  transform-style: preserve-3d;
  transition: transform 0.3s;
}

.contact-info-block:hover {
  transform: translateZ(16px) translateY(-6px);
  box-shadow:
    0 24px 40px rgba(0,0,0,0.5),
    0 0 24px rgba(245,166,35,0.1);
}

/* ============================================================
   ABOUT / FORM PANELS — angled depth frame
   ============================================================ */
.about-panel,
.skeu-form-panel {
  position: relative;
  transform-style: preserve-3d;
}

.about-panel::after,
.skeu-form-panel::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: inherit;
  box-shadow: 0 40px 60px -20px rgba(0,0,0,0.45);
  z-index: -1;
  transform: translateZ(-12px) scale(0.97);
}

/* ============================================================
   FORM INPUTS — recessed 3D well
   ============================================================ */
.form-control-skeu {
  box-shadow:
    inset 0 3px 6px rgba(0,0,0,0.4),
    inset 0 1px 3px rgba(0,0,0,0.3),
    0 1px 0 rgba(255,255,255,0.6);
  transition: box-shadow 0.15s, transform 0.15s;
}

.form-control-skeu:focus {
  transform: translateZ(-2px);
  box-shadow:
    inset 0 3px 8px rgba(0,0,0,0.45),
    inset 0 1px 3px rgba(0,0,0,0.3),
    0 0 0 2px rgba(212,134,10,0.4);
}

/* ============================================================
   PROJECT CARDS (project.html) — deep hover lift
   ============================================================ */
.proj-img {
  transform: translateZ(4px);
}

/* ============================================================
   WHATSAPP FLOAT — 3D orb
   ============================================================ */
.float-wa {
  transform-style: preserve-3d;
  box-shadow:
    var(--shadow-raised),
    0 0 16px rgba(37,211,102,0.4),
    0 10px 20px rgba(0,0,0,0.4);
  transition: transform 0.2s;
}

.float-wa:hover {
  transform: scale(1.12) translateZ(10px) rotateY(10deg);
}

/* ============================================================
   PAGE HEADER PANELS (service/about/contact/project headers)
   subtle parallax tilt container
   ============================================================ */
.tilt-stage {
  perspective: 1200px;
}

/* ============================================================
   MOUSE-REACTIVE TILT (JS-driven via data-tilt attribute)
   ============================================================ */
[data-tilt] {
  transition: transform 0.1s ease-out;
  transform-style: preserve-3d;
}

/* ============================================================
   REDUCED MOTION
   ============================================================ */
@media (prefers-reduced-motion: reduce) {
  .hero-logo-panel,
  .skeu-card,
  .team-card,
  .contact-info-block,
  .btn-skeu-primary,
  .btn-skeu-outline,
  .float-wa {
    animation: none !important;
    transition: none !important;
  }
}

@media (max-width: 600px) {
  .skeu-card:hover,
  .team-card:hover,
  .contact-info-block:hover {
    transform: translateY(-4px);
  }
}